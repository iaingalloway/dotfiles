# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
assertions:
  - resource: Microsoft.Windows.Developer/OsVersion
    directives:
      description: Verify min OS version requirement
    settings:
      MinVersion: '10.0.26200'
resources:
  - name: winget-source
    type: Microsoft.WinGet/Source
    metadata:
      description: Configure the WinGet package source
    properties:
      name: winget
      argument: https://cdn.winget.microsoft.com/cache
      explicit: false
      trustLevel: trusted
      type: Microsoft.PreIndexed.Package

  - name: winget-font-source
    type: Microsoft.WinGet/Source
    metadata:
      description: Configure the WinGet font source
    properties:
      name: winget-font
      argument: https://cdn.winget.microsoft.com/fonts
      explicit: true
      trustLevel: trusted
      type: Microsoft.PreIndexed.Package

  - name: winget-user-settings
    type: Microsoft.WinGet/UserSettingsFile
    metadata:
      description: Enable WinGet font packages
    properties:
      action: Partial
      settings:
        experimentalFeatures:
          fonts: true

  - name: sudo
    type: Microsoft.Windows/Registry
    metadata:
      description: Enable Windows Sudo with input disabled
      winget:
        securityContext: elevated
    properties:
      keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo
      valueName: Enabled
      valueData:
        DWord: 2
      _exist: true

  - name: wsl
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Windows Subsystem for Linux
    dependsOn:
      - winget-source
    properties:
      id: Microsoft.WSL
      source: winget

  - name: powershell
    type: Microsoft.WinGet/Package
    metadata:
      description: Install PowerShell
    dependsOn:
      - winget-source
    properties:
      id: Microsoft.PowerShell
      source: winget

  - name: windows-terminal
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Windows Terminal
    dependsOn:
      - winget-source
    properties:
      id: Microsoft.WindowsTerminal
      source: winget

  - name: visual-studio-code
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Visual Studio Code
    dependsOn:
      - winget-source
    properties:
      id: Microsoft.VisualStudioCode
      source: winget

  - name: docker-desktop
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Docker Desktop
    dependsOn:
      - winget-source
    properties:
      id: Docker.DockerDesktop
      source: winget

  - name: chrome
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Google Chrome
    dependsOn:
      - winget-source
    properties:
      id: Google.Chrome
      source: winget

  - name: starship
    type: Microsoft.WinGet/Package
    metadata:
      description: Install Starship
    dependsOn:
      - winget-source
    properties:
      id: Starship.Starship
      source: winget

  - name: caskaydia-cove
    type: Microsoft.WinGet/Package
    metadata:
      description: Install CaskaydiaCove Nerd Font
    dependsOn:
      - winget-font-source
      - winget-user-settings
    properties:
      id: ryanoasis.CaskaydiaCove
      source: winget-font

  - name: taskbar-alignment
    type: Microsoft.Windows/Registry
    metadata:
      description: Align taskbar buttons to the left
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: TaskbarAl
      valueData:
        DWord: 0
      _exist: true

  - name: disable-search-suggestions
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable search box suggestions
    properties:
      keyPath: HKCU\Software\Policies\Microsoft\Windows\Explorer
      valueName: DisableSearchBoxSuggestions
      valueData:
        DWord: 1
      _exist: true

  - name: disable-content-delivery-suggestions
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable suggested content in Windows
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-310093Enabled
      valueData:
        DWord: 0
      _exist: true

  - name: disable-content-delivery-tips
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable suggested content in Windows
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-338389Enabled
      valueData:
        DWord: 0
      _exist: true

  - name: disable-windows-welcome-experience
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable the Windows welcome experience
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\UserProfileEngagement
      valueName: ScoobeSystemSettingEnabled
      valueData:
        DWord: 0
      _exist: true

  - name: disable-mouse-acceleration
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable pointer acceleration
    properties:
      keyPath: HKCU\Control Panel\Mouse
      valueName: MouseSpeed
      valueData:
        String: '0'
      _exist: true

  - name: disable-mouse-acceleration-threshold-1
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable pointer acceleration
    properties:
      keyPath: HKCU\Control Panel\Mouse
      valueName: MouseThreshold1
      valueData:
        String: '0'
      _exist: true

  - name: disable-mouse-acceleration-threshold-2
    type: Microsoft.Windows/Registry
    metadata:
      description: Disable pointer acceleration
    properties:
      keyPath: HKCU\Control Panel\Mouse
      valueName: MouseThreshold2
      valueData:
        String: '0'
      _exist: true
